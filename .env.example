# ─── Admin sign-in (required) ─────────────────────────────────────────
ADMIN_EMAIL=you@example.com
# bcrypt hash of the admin password. Generate with:
#   node -e "require('bcryptjs').hash('YOUR_PASSWORD', 12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Random 32+ character secret used to sign admin session tokens. Never reuse the password.
SESSION_SECRET=

# ─── Supabase (required) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://ldwmbwsxrktpcisqaxrb.supabase.co
# Public anon key (safe to expose; RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Which company this deployment is: ca (default) or us. Picks the profile in lib/site.ts
# (name, URL, currency, phone, address, registrations). The .com sets NEXT_PUBLIC_SITE_ID=us.
NEXT_PUBLIC_SITE_ID=ca
# Kill switch for the page cache (docs/factory/CACHE-LOOP.md). ON when unset. Set to "off" on Vercel and
# redeploy/restart and middleware.ts stops sending visitors to the cacheable copy of each public page, so every
# page is rendered per request exactly as before. Read at request time, not build time.
CACHE_PUBLIC_PAGES=on
# Kill switch for the post-publish check (lib/publish-verify.ts). ON when unset. Set to "off" and the pipeline stops fetching newly
# published pages without a cookie to check them (status, canonical, one H1, JSON-LD, sitemap). It only ever reads; it changes nothing.
PUBLISH_VERIFY=on
# Optional single-field overrides of the profile.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_LOCALE=
NEXT_PUBLIC_SITE_PHONE=
# The other company's live URL, once it runs this same codebase (e.g. .ca sets this to the .com
# replica's URL and vice versa). Unset until that replica exists; hreflang tags are omitted until
# it is set on both deployments, so we never point Google at a page that doesn't exist yet.
NEXT_PUBLIC_SIBLING_SITE_URL=
# Service role key: server-side only, bypasses RLS. Required for every admin write
# (packages, roadmap, keywords, image uploads).
SUPABASE_SERVICE_ROLE_KEY=
# Migration drift (docs/factory/MIGRATIONS-CI.md). These two are GITHUB repo secrets (Settings > Secrets and variables > Actions),
# NOT Vercel env vars, and are read only by .github/workflows/migrations.yml and scripts/migration-drift.ts. Both optional: without
# them the workflow only checks the folder. SUPABASE_ACCESS_TOKEN = Supabase Account > Access Tokens. SUPABASE_PROJECT_REF = ldwmbwsxrktpcisqaxrb.
# The manual "apply" button also needs a third secret, SUPABASE_DB_PASSWORD. Nothing applies a migration on a push.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# ─── Leads (GoHighLevel) ──────────────────────────────────────────────
# Leads and newsletter signups use GOHIGHLEVEL_PRIVATE_TOKEN (listed below, under social posting)
# when it is set: it needs the contacts and opportunities permissions as well. The older
# GOHIGHLEVEL_API_KEY is the retired v1 API and is only used when no token is set.
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=
GOHIGHLEVEL_PIPELINE_ID=
# Optional: the pipeline stage a new lead lands in. Unset = the first stage of the pipeline above.
GOHIGHLEVEL_PIPELINE_STAGE_ID=
# Inbound webhook (factory Phase 4): set this, then add the same value as a header or body field
# named "x-ghl-secret"/"secret" on a GHL workflow's webhook action pointed at
# /api/ghl/webhook. Unset means the route always refuses (503) - never left open by default.
GOHIGHLEVEL_WEBHOOK_SECRET=

# ─── Analytics & SEO ──────────────────────────────────────────────────
# GA4 measurement id (G-XXXXXXXXXX). The gtag snippet renders only when set.
NEXT_PUBLIC_GA_ID=
# Optional. GA4 Measurement Protocol API secret (GA4 Admin > Data streams > your stream > Measurement Protocol API secrets).
# With this AND NEXT_PUBLIC_GA_ID set, a saved lead that carries the visitor's GA client id (sent only after they accepted
# analytics) also sends a server-side generate_lead event. Unset means no server-side event is ever sent. Never exposed to the browser.
GA4_MEASUREMENT_PROTOCOL_SECRET=
# DataForSEO login + password for /admin/keywords (real $ per lookup; results are cached 30 days).
# Get both from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Real traffic on the admin dashboard (GA4 Data API). GA4_PROPERTY_ID is the numeric property id;
# GOOGLE_SERVICE_ACCOUNT_KEY is the service account's JSON key, raw or base64-encoded.
# The service account needs Viewer access on the GA4 property.
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Search Console query data in /admin/keywords uses the same service account; add its email as a
# user on the Search Console property. Default site is the domain property.
SEARCH_CONSOLE_SITE_URL=sc-domain:travelfunbiz.ca
# The same service account also asks Google's URL Inspection API (lib/gsc-inspect.ts) whether a small batch of pages (at most 20 a day) is
# really indexed. Nothing new to set: if Google answers 403 the Needs attention list says to add the service account as a user on the property.
# Bing Webmaster Tools API key (free; site must be verified there). The daily rankings job uses it for one read-only
# crawled/indexed summary shown on Search Rankings (nothing is called while it is empty).
BING_WEBMASTER_API_KEY=
# IndexNow key (8-128 letters, digits, dashes; make one up or use Bing Webmaster's generator).
# When set, publishing/updating/deleting a package pings Bing so it recrawls within minutes.
# The key is served at /indexnow-key.txt automatically.
INDEXNOW_KEY=

# ─── Optional integrations ────────────────────────────────────────────
# ScrapingBee, used by /admin/packages "Scrape URL" for third-party sites.
SCRAPINGBEE_API_KEY=
# Pexels (free), used by the image format pipeline (lib/pexels.ts) to find a real photo of a
# destination/city/port when a package has no source image yet. Sign up free at pexels.com/api;
# unset means that lookup is skipped (an explicit error, not a silent placeholder image).
PEXELS_API_KEY=
# OpenAI (real per-image cost), used only when the admin clicks "Generate AI image" on a package
# with no source photo AND no Pexels match — never an automatic fallback. Get a key at
# platform.openai.com/api-keys. Unset means that button returns a clear error instead of failing
# silently.
OPENAI_API_KEY=
# Alpha Vantage, used for live USD -> CAD/AUD/EUR rates (falls back to fixed rates when unset).
ALPHA_VANTAGE_API_KEY=

# ─── Factory parity program (docs/factory/) ───────────────────────────
# Required before any scheduled job in later phases can run at all (lib/cron-auth.ts refuses
# every /api/cron/* request outright while this is unset - "no secret configured" never means
# "anyone may run it"). Any random 32+ character string.
CRON_SECRET=
# Salts the IP/email hash lib/abuse-guard.ts stores for its rate limiter, so the raw value is
# never in the database. Falls back to CRON_SECRET if unset; set your own for a real deployment.
RATE_LIMIT_SALT=
# Anthropic API key. Dormant (lib/ai-verify.ts no-ops) until Phase 3 (autoblog) turns it on -
# decision 7, 2026-09-26: in scope, real per-call cost accepted, effective from that phase.
# Also powers the admin package tools: "Paste source material" (AI draft builder, facts only,
# never invented) and the per-field AI buttons in the package form (grounded in the form's own
# text). Both return a clear "not configured" error when this is unset - no canned fallback text.
ANTHROPIC_API_KEY=
# Optional: pin a specific model instead of the built-in best-available fallback list.
ANTHROPIC_MODEL=
# Optional: only needed for an identity-linked (not workspace-scoped) Anthropic key.
ANTHROPIC_WORKSPACE_ID=
# Upload-Post (upload-post.com) — the social auto-distribution provider Joel picked 2026-09-27.
# Dormant (lib/upload-post.ts, the /api/cron/distribute cron) until this is set. Get a key at
# upload-post.com after connecting your social accounts to a profile there; the profile's
# "username" and which platforms to post to are then set on /admin/distribution, not here.
UPLOAD_POST_API_KEY=
# Pinterest board id for Upload-Post (a long number). Upload-Post refuses every Pinterest pin without one
# ("Pinterest Board ID is required"), so Pinterest stays paused until this is set. List your boards with
# GET https://api.upload-post.com/api/uploadposts/pinterest/boards?user=<profile> (header Authorization: Apikey <key>).
UPLOAD_POST_PINTEREST_BOARD_ID=
# Shotstack (shotstack.io) — hosted video render API for the short-form video pipeline
# (lib/shotstack.ts, lib/video-script.ts). Dormant until this is set, and even then only fires
# from a manual "Generate video" admin click (app/admin/blog/[id]/page.tsx), never a cron, both
# because it costs real money per render and because lib/shotstack.ts's integration is NOT yet
# live-tested against a real account (see that file's own header comment) - the first real render
# should be treated as a test. Get a key at shotstack.io; the free "sandbox" stage is the one to
# test with before switching to a production key.
SHOTSTACK_API_KEY=
# Which Shotstack environment the key belongs to: leave blank (or "stage") for the free sandbox key -
# videos render watermarked and Autopilot never posts them. Set to "v1" ONLY with a production key.
SHOTSTACK_ENV=

# Optional: failure alerts from Content Autopilot, emailed to ADMIN_EMAIL (at most one per 6 hours).
# Free account at resend.com; leave blank to skip alerts. ALERT_FROM_EMAIL needs a verified domain;
# if blank, mail goes from onboarding@resend.dev, which only delivers to the Resend account owner.
# Optional: Reddit questions as a keyword-idea source (free). Make an app at reddit.com/prefs/apps (type
# "script"), then paste its id (under the app name) and its secret. Unset = that source stays off.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
RESEND_API_KEY=
# The 7 am daily brief ("Aiva from TravelFunBiz.ca") goes to joelfrenette@gmail.com, and alerts go to
# ADMIN_EMAIL, unless NOTIFY_TO_EMAIL is set (it overrides both). Until a domain is verified in Resend,
# Resend only delivers to the account owner's own address, so set NOTIFY_TO_EMAIL to that address.
# Sent from ALERT_FROM_EMAIL, else onboarding@resend.dev.
NOTIFY_TO_EMAIL=
ALERT_FROM_EMAIL=

# Optional: "Instant lead reply" (OFF until switched on in Admin, System Health). An acknowledgement email to the lead,
# sent through Resend. It must come from an address on a domain verified in Resend (onboarding@resend.dev only reaches
# the account owner, so it cannot be used here). Leave blank and nothing is sent. Wording: lib/lead-ack-copy.ts (DRAFT pending CASL review).
LEAD_ACK_FROM_EMAIL=
# Where a lead's reply to that email goes (Reply-To). Blank = the same address alerts use (NOTIFY_TO_EMAIL, else ADMIN_EMAIL).
# Use a mailbox that is actually read: the email's footer tells people to reply to stop mail.
LEAD_ACK_REPLY_TO=
# At most 50 of these go out per day in total; over that they are skipped silently.

# Optional: the lead desk (lib/lead-desk.ts, migration 0055). A "hot lead" (a callback request from a trip page, or any form with a phone
# number) emails and texts the desk (Joel, Shelby, Leslie), who then choose the agent. Nothing is assigned automatically.
# The people and contacts are app_settings keys, not env vars, so they change without a redeploy:
#   lead_desk_alert_emails            the desk addresses (a JSON list or addresses separated by commas). Empty = the usual alert
#                                     address (NOTIFY_TO_EMAIL, else ADMIN_EMAIL).
#   lead_desk_alert_sms_contact_ids   GoHighLevel contact ids to text (needs GOHIGHLEVEL_PRIVATE_TOKEN with the conversations
#                                     message permission). Empty = no text is sent (an amber setup item on Needs attention).
#   lead_desk_alert_office_team       "on" also emails whoever holds the CEO, CTO and Manager roles on the Agents roster (their private
#                                     roster emails, de-duplicated with the list above). Missing or "off" = off. Set it with the switch
#                                     on the Agents screen. Leave it off until a sending domain is verified (migration 0057 adds the roles).
# The email to an assigned agent goes to that agent's private roster email. Like the lead reply above, Resend only delivers to the
# account owner until a domain is verified, so set a verified sender here (else LEAD_ACK_FROM_EMAIL, else ALERT_FROM_EMAIL, is used).
LEAD_DESK_FROM_EMAIL=

# Optional: post through GoHighLevel Social Planner instead of Upload-Post (pick it in the Where it
# posts box on Content Autopilot). The older GOHIGHLEVEL_API_KEY cannot do this. In GHL: Settings,
# Private Integrations, create a token with the Social Planner permissions. USER_ID is the GHL user
# the posts are created as.
GOHIGHLEVEL_PRIVATE_TOKEN=
GOHIGHLEVEL_USER_ID=

# Hreflang: set to on only once the .com replica serves the same paths (also needs NEXT_PUBLIC_SIBLING_SITE_URL). Off by default.
NEXT_PUBLIC_HREFLANG_SIBLING=

# Optional: the "same meaning" topic check (lib/topic-meaning.ts, lib/topic-meaning-run.ts). No env var and no migration: two app_settings keys.
#   auto_policy_topic_meaning   ON unless exactly "off". A blog topic (approved-queue pick, keyword-research pick, AI suggestion, new queue
#                               suggestion) that means the same as an existing post, a queued topic or a recent rejection is skipped:
#                               a queue row becomes "rejected" with "duplicate of <slug>" in its why, the run moves on to the next candidate,
#                               and the Autopilot decisions log shows it with an Undo. Free: word stems, synonyms and TF-IDF only.
#   topic_meaning_ai            OFF unless exactly "on". Lets a cheap model settle BORDERLINE pairs only (similarity 0.50 to 0.72), at most
#                               10 calls per UTC day (counter app_settings topic_meaning_ai_calls:<day>). Unclear or failed answer = not a duplicate.

# Optional: the near page 1 refresh loop (lib/refresh-loop.ts, run inside the daily heal-content step, no new cron). No env var and no migration: one app_settings key.
#   refresh_loop_mode           OFF unless exactly "on" (unset, unreadable or anything else = off; while off it reads and writes nothing). When on, at most 2 pages a day
#                               whose average Google position is 8 to 20 (100+ impressions, newest Search Console snapshot at most 4 days old) get up to 2 real internal
#                               links, logged to content_edits first (Undo works). A missing FAQ or takeaways list is written by the heal generator and held for review.
#                               A page is not touched again for 30 days; after 30 days the links are undone by themselves only if the position got 3+ places worse.
#                               Model calls come out of heal_loop_calls_per_day. News posts and trip pages are never touched.
# Optional: travel advisory pages (/travel-advisories, one evergreen page per country). No env var and no API key: one app_settings key plus migration 0062.
#   country_advisories_mode   OFF unless exactly "log" or "on" (anything else, or unreadable, means off). log: the Canada and UK news ingest also records
#                             country_advisories and country_advisory_log, and no public page exists (404). on: pages are public, listed in the sitemap,
#                             linked from matching destination guides, and a Government of Canada LEVEL change may be posted to social (at most one post per
#                             country per 7 days, through the normal Post Distribution switches and daily caps). Set it in Admin > Posts > News.
# Optional: "Send me the itinerary and dates" on trip pages (lib/itinerary-magnet.ts). OFF by default and needs no env var to stay off.
#   app_settings itinerary_magnet_mode   exactly "on" turns it on (switch on System health); missing or anything else is off.
#   ITINERARY_TOKEN_SECRET               signs the private itinerary link (one lead, one trip, 90 days). Empty = SESSION_SECRET is used;
#                                        with neither set the form answers "not available" and no lead is created.
#   The link is emailed only through the instant lead reply (lead_ack_email, RESEND_API_KEY, LEAD_ACK_FROM_EMAIL above). Apply migration 0063 first.
#   Per trip request counts: app_settings itinerary_requests (shown on System health).
ITINERARY_TOKEN_SECRET=
